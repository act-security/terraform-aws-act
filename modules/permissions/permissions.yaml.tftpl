deployment_version: "20261109-4aa4885f"
managed_policies:
  - SecurityAudit
  - job-function/ViewOnlyAccess
policies:
  CustomPolicy1:
    Version: "2012-10-17"
    Statement:
      - Action:
          - s3:GetObject
          - s3:GetObjectRetention
          - s3:GetObjectAttributes
        Effect: Allow
        Resource:
          - arn:${partition}:s3:::${cloudtrail_bucket_name}/AWSLogs/*
          - arn:${partition}:s3:::${cloudtrail_bucket_name}/*/AWSLogs/*
        Sid: ActSecurityS3AWSLogsGetObject
      - Action:
          - s3:ListBucket
        Condition:
          StringLike:
            s3:prefix:
              - AWSLogs/*
              - "*/AWSLogs/*"
        Effect: Allow
        Resource:
          - arn:${partition}:s3:::${cloudtrail_bucket_name}
        Sid: ActSecurityS3AWSLogsListBucket
      - Action:
          - kms:Decrypt
        Condition:
          StringLike:
            kms:ViaService:
              - s3.*.amazonaws.com
        Effect: Allow
        Resource:
          - arn:${partition}:kms:*:*:key/*
        Sid: ActSecurityS3KMSDecrypt
      - Action:
          - logs:GetLogEvents
          - logs:FilterLogEvents
          - logs:StartQuery
          - logs:GetQueryResults
        Effect: Allow
        Resource:
          - arn:${partition}:logs:*:*:log-group:*
          - arn:${partition}:logs:*:*:log-group:*:*
        Sid: ActSecurityCloudWatchLogsReadAccess
      - Action:
          - kms:Decrypt
        Condition:
          StringLike:
            kms:ViaService:
              - logs.*.amazonaws.com
        Effect: Allow
        Resource:
          - arn:${partition}:kms:*:*:key/*
        Sid: ActSecurityCloudWatchKMSDecrypt
      - Action:
          - s3express:ListAccessPointsForDirectoryBuckets
          - s3express:GetAccessPoint
          - s3express:GetAccessPointPolicy
          - s3express:GetAccessPointScope
          - s3express:ListTagsForResource
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityS3ExpressAccessPointPolicyRead
      - Action:
          - lambda:GetFunction
          - lambda:GetLayerVersion
          - lambda:GetNetworkConnector
          - lambda:GetMicrovm
          - eks:DescribeClusterVersions
          - eks:ListPodIdentityAssociations
          - eks:DescribePodIdentityAssociation
          - eks:ListIdentityProviderConfigs
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityExtendedComputeViewAccess
      - Action:
          - dynamodb:GetResourcePolicy
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityDynamoDBPolicyAccess
      - Action:
          - ssm:GetResourcePolicies
        Effect: Allow
        Resource: "*"
        Sid: ActSecuritySsmParameterPolicyRead
      - Action:
          - kinesis:GetResourcePolicy
        Effect: Allow
        Resource: arn:${partition}:kinesis:*:${account_id}:stream/*
        Sid: ActSecurityKinesisGetResourcePolicy
      - Action: eks:DescribeAccessEntry
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityEKSDescribeAccessEntry
      - Action:
          - organizations:DescribeOrganization
          - organizations:DescribeEffectivePolicy
          - organizations:ListRoots
          - organizations:ListOrganizationalUnitsForParent
          - organizations:ListAccountsForParent
          - organizations:ListPolicies
          - organizations:DescribePolicy
          - organizations:ListPoliciesForTarget
          - organizations:ListTargetsForPolicy
          - organizations:ListTagsForResource
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityOrganizationsReadPolicies
      - Action:
          - kafka-cluster:Connect
          - kafka-cluster:DescribeTopic
          - kafka-cluster:DescribeCluster
          - kafka:GetBootstrapBrokers
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityKafkaAccess
      - Action:
          - bedrock:GetAgent
          - bedrock:GetAgentActionGroup
          - bedrock:GetAgentVersion
          - bedrock:GetAgentCollaborator
          - bedrock:GetKnowledgeBase
          - bedrock:GetDataSource
          - bedrock:GetFlow
          - bedrock:GetFlowVersion
          - bedrock:GetPrompt
          - bedrock:GetGuardrail
          - bedrock:GetEvaluationJob
          - bedrock:ListAutomatedReasoningPolicies
          - bedrock:GetAutomatedReasoningPolicy
          - bedrock:ListPromptRouters
          - bedrock:GetPromptRouter
          - bedrock:ListBlueprints
          - bedrock:GetBlueprint
          - bedrock:ListDataAutomationProjects
          - bedrock:GetDataAutomationProject
          - bedrock:ListDataAutomationLibraries
          - bedrock:GetDataAutomationLibrary
          - bedrock:GetResourcePolicy
          - bedrock:GetAgentMemory
          - bedrock:ListEnforcedGuardrailsConfiguration
        Effect: Allow
        Resource: "*"
        Sid: BedrockSecurityAuditComplete
  CustomPolicy2:
    Version: "2012-10-17"
    Statement:
      - Action:
          - aoss:ListCollections
          - aoss:BatchGetCollection
          - aoss:GetAccessPolicy
          - aoss:GetSecurityPolicy
        Effect: Allow
        Resource: "*"
        Sid: OpenSearchServerlessForKBVectorStores
      - Action:
          - apigateway:GET
        Effect: Allow
        Resource:
          - arn:${partition}:apigateway:*::/restapis/*
          - arn:${partition}:apigateway:*::/apis/*
          - arn:${partition}:apigateway:*::/vpclinks/*
          - arn:${partition}:apigateway:*::/account
          - arn:${partition}:apigateway:*::/usageplans
          - arn:${partition}:apigateway:*:*:/domainnameaccessassociations
        Sid: ActSecurityAPIGatewayAccess
      - Action:
          - s3:GetAccessGrantsInstance
          - s3:ListAccessGrantsLocations
          - s3:ListTagsForResource
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityS3AccessGrantsRead
      - Action:
          - s3:GetJobTagging
          - s3:GetStorageLensConfigurationTagging
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityS3ControlTaggingRead
      - Action:
          - iot:GetTopicRule
        Effect: Allow
        Resource: arn:${partition}:iot:*:*:rule/*
        Sid: ActSecurityIoTTopicRuleGet
      - Action:
          - bedrock-agentcore:ListApiKeyCredentialProviders
          - bedrock-agentcore:GetApiKeyCredentialProvider
          - bedrock-agentcore:ListOauth2CredentialProviders
          - bedrock-agentcore:GetOauth2CredentialProvider
          - bedrock-agentcore:ListPaymentCredentialProviders
          - bedrock-agentcore:GetPaymentCredentialProvider
          - bedrock-agentcore:ListPaymentConnectors
          - bedrock-agentcore:GetPaymentConnector
          - bedrock-agentcore:ListPaymentManagers
          - bedrock-agentcore:GetPaymentManager
          - bedrock-agentcore:GetTokenVault
          - bedrock-agentcore:ListWorkloadIdentities
          - bedrock-agentcore:GetWorkloadIdentity
          - bedrock-agentcore:ListEvaluators
          - bedrock-agentcore:GetEvaluator
          - bedrock-agentcore:ListOnlineEvaluationConfigs
          - bedrock-agentcore:GetOnlineEvaluationConfig
          - bedrock-agentcore:ListDatasets
          - bedrock-agentcore:ListMemories
          - bedrock-agentcore:GetMemory
          - bedrock-agentcore:GetResourcePolicy
          - bedrock-agentcore:ListTagsForResource
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityBedrockAgentcoreRead
      - Action:
          - signin:GetResourcePolicy
        Effect: Allow
        Resource: "*"
        Sid: ActSecuritySigninResourcePolicyRead
      - Action:
          - sagemaker:GetModelPackageGroupPolicy
        Effect: Allow
        Resource: arn:${partition}:sagemaker:*:*:model-package-group/*
        Sid: ActSecuritySageMakerModelPackageGroupPolicyRead
      - Action:
          - cloudhsm:DescribeClusters
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityCloudHsmRead
      - Action:
          - cloudtrail:ListEventDataStores
          - cloudtrail:GetEventDataStore
          - cloudtrail:ListChannels
          - cloudtrail:GetChannel
          - cloudtrail:ListDashboards
          - cloudtrail:GetDashboard
          - cloudtrail:GetResourcePolicy
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityCloudTrailLakeRead
      - Action:
          - cloudformation:DescribeChangeSet
          - cloudformation:DescribeGeneratedTemplate
          - cloudformation:DescribeResourceScan
          - cloudformation:DescribePublisher
          - cloudformation:DescribeType
          - cloudformation:BatchDescribeTypeConfigurations
        Effect: Allow
        Resource: "*"
        Sid: ActSecurityCloudFormationRead
capabilities:
  eks_cluster_access:
    EksClusterAccess:
      Version: "2012-10-17"
      Statement:
        - Action: eks:AccessKubernetesApi
          Effect: Allow
          Resource: arn:${partition}:eks:*:${account_id}:cluster/*
          Sid: ActSecurityEKSAccessKubernetesApi
        - Action: eks:CreateAccessEntry
          Condition:
            ArnEquals:
              eks:principalArn: arn:${partition}:iam::${account_id}:role/${role_name}
            ForAllValues:StringEquals:
              aws:TagKeys:
                - CreatedBy
            "Null":
              eks:kubernetesGroups: "true"
              eks:username: "true"
            StringEquals:
              aws:RequestTag/CreatedBy: ActSecurity
            StringEqualsIfExists:
              eks:accessEntryType: STANDARD
          Effect: Allow
          Resource: arn:${partition}:eks:*:${account_id}:cluster/*
          Sid: ActSecurityEKSCreateAccessEntry
        - Action: eks:DeleteAccessEntry
          Condition:
            StringEquals:
              aws:ResourceTag/CreatedBy: ActSecurity
          Effect: Allow
          Resource: arn:${partition}:eks:*:${account_id}:access-entry/*/role/${account_id}/${role_name}/*
          Sid: ActSecurityEKSDeleteAccessEntry
        - Action: eks:TagResource
          Condition:
            ForAllValues:StringEquals:
              aws:TagKeys:
                - CreatedBy
            StringEquals:
              aws:RequestTag/CreatedBy: ActSecurity
          Effect: Allow
          Resource: arn:${partition}:eks:*:${account_id}:access-entry/*/role/${account_id}/${role_name}/*
          Sid: ActSecurityEKSTagAccessEntry
        - Action: eks:AssociateAccessPolicy
          Condition:
            ArnEquals:
              eks:policyArn: arn:${partition}:eks::aws:cluster-access-policy/AmazonEKSViewPolicy
              eks:principalArn: arn:${partition}:iam::${account_id}:role/${role_name}
            StringEquals:
              eks:accessScope: cluster
          Effect: Allow
          Resource: arn:${partition}:eks:*:${account_id}:access-entry/*/role/${account_id}/${role_name}/*
          Sid: ActSecurityEKSAssociateViewPolicy
