{
  "Statement": [
    {
      "Action": [
        "s3:GetAccessGrantsInstance",
        "s3:ListAccessGrantsLocations",
        "s3:ListTagsForResource"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityS3AccessGrantsRead"
    },
    {
      "Action": [
        "s3:GetJobTagging",
        "s3:GetStorageLensConfigurationTagging"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityS3ControlTaggingRead"
    },
    {
      "Action": [
        "iot:GetTopicRule"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:iot:*:*:rule/*",
      "Sid": "ActSecurityIoTTopicRuleGet"
    },
    {
      "Action": [
        "signin:GetResourcePolicy"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecuritySigninResourcePolicyRead"
    },
    {
      "Action": [
        "cloudhsm:DescribeClusters"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityCloudHsmRead"
    },
    {
      "Action": [
        "cloudtrail:ListEventDataStores",
        "cloudtrail:GetEventDataStore",
        "cloudtrail:ListChannels",
        "cloudtrail:GetChannel",
        "cloudtrail:ListDashboards",
        "cloudtrail:GetDashboard",
        "cloudtrail:GetResourcePolicy"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityCloudTrailLakeRead"
    },
    {
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeGeneratedTemplate",
        "cloudformation:DescribeResourceScan",
        "cloudformation:DescribePublisher",
        "cloudformation:DescribeType",
        "cloudformation:BatchDescribeTypeConfigurations"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityCloudFormationRead"
    },
    {
      "Action": [
        "networkmanager:ListCoreNetworks",
        "networkmanager:GetCoreNetwork",
        "networkmanager:GetCoreNetworkPolicy",
        "networkmanager:ListAttachments",
        "networkmanager:GetVpcAttachment",
        "networkmanager:GetConnectAttachment",
        "networkmanager:ListPeerings",
        "networkmanager:GetResourcePolicy"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityCloudWanRead"
    },
    {
      "Action": [
        "network-firewall:ListTLSInspectionConfigurations",
        "network-firewall:DescribeTLSInspectionConfiguration",
        "network-firewall:ListVpcEndpointAssociations",
        "network-firewall:DescribeVpcEndpointAssociation"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ActSecurityNetworkFirewallTlsAndEndpointAssociationRead"
    }
  ],
  "Version": "2012-10-17"
}
